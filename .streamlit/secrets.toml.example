{
  "type": "service_account",
  "project_id": "your-google-cloud-project-id",
  "private_key_id": "...",
  "private_key": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",
  "client_email": "zarailens@your-google-cloud-project-id.iam.gserviceaccount.com",
  "client_id": "...",
  "token_uri": "https://oauth2.googleapis.com/token"
}
'''

NOMINATIM_USER_AGENT = "ZarailensAI/1.0 (your-contact@example.org)"
